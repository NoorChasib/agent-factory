# Agent Factory environment configuration.
# Copy this file to .env (kept out of git) and fill in the values for your
# machine. Every variable here is read exclusively through src/env.ts.

# Claude worker runtime. Effort accepts: low, medium, high, max.
AGENT_FACTORY_CLAUDE_MODEL=claude-fable-5
AGENT_FACTORY_CLAUDE_EFFORT=high

# Global scheduling limit applied to every lane. A non-negative integer;
# 0 pauses all launches.
AGENT_FACTORY_LIMIT=1

# GitHub App credentials. The private-key value is a file path, never PEM
# contents. See docs/github-app.md.
AGENT_FACTORY_GITHUB_APP_ID=123456
AGENT_FACTORY_GITHUB_APP_PRIVATE_KEY_FILE=/run/credentials/agent-factory/github-app.pem

# Optional: absolute path to the factory source repository used for release
# builds. Defaults to the running checkout when unset.
# AGENT_FACTORY_SOURCE_REPOSITORY=/absolute/path/to/agent-factory
