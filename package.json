{
	"name": "agent-factory",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"module": "src/index.ts",
	"bin": {
		"agent-factory": "bin/agent-factory",
		"agent-factory-daemon": "bin/agent-factory-daemon"
	},
	"scripts": {
		"bootstrap": "bun src/installation/main.ts",
		"build:binaries": "bun src/installation/build-binaries.ts",
		"docs:dev": "vitepress dev",
		"docs:build": "vitepress build",
		"docs:preview": "vitepress preview",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"fallow:audit": "fallow audit",
		"fallow:staged": "git diff --cached --no-ext-diff --unified=0 | fallow audit --base HEAD --diff-stdin",
		"release": "bun scripts/release.ts",
		"test:skills": "cd .agents/skills/agent-factory-address-pr-feedback && python3 -m unittest discover tests",
		"validate": "bun run typecheck && bun run lint && bun test && bun run test:skills",
		"prepare": "if git symbolic-ref -q HEAD >/dev/null 2>&1; then lefthook install; fi"
	},
	"dependencies": {
		"yaml": "2.9.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@socketsecurity/bun-security-scanner": "1.1.2",
		"@types/bun": "1.3.14",
		"fallow": "3.7.1",
		"lefthook": "2.1.10",
		"typescript": "7.0.2",
		"vitepress": "1.6.4"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
